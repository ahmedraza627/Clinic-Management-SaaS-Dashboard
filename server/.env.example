# ─────────────────────────────────────────────────────────────
# ClinicOS server environment
# Copy to server/.env  →  cp server/.env.example server/.env
# ─────────────────────────────────────────────────────────────

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────
# OPTION A — Local mongod (default):
MONGO_URI=mongodb://127.0.0.1:27017/clinic_dev
#
# OPTION B — MongoDB Atlas (recommended: no local service needed)
# 1. Create a free M0 cluster at https://www.mongodb.com/cloud/atlas
# 2. "Database Access"  → create a user (username + password)
# 3. "Network Access"   → add your IP (or 0.0.0.0/0 while developing)
# 4. "Connect" → "Drivers" → copy the SRV string, then set:
#
# MONGO_URI=mongodb+srv://<dbUser>:<dbPassword>@cluster0.xxxxx.mongodb.net/clinic_dev?retryWrites=true&w=majority
#
# NOTE: URL-encode the password if it contains special chars
#       (@ : / # ? [ ] %) — e.g. p@ss → p%40ss
#
# MONGODB_URI is still accepted as a legacy alias for MONGO_URI.
# MONGODB_URI=mongodb://127.0.0.1:27017/clinic_dev

# ── Driver tuning ──
MONGO_MAX_POOL=20

# ── Billing ──
DEFAULT_TAX_RATE=0.05
